# Optional: copy to .env and adjust.
# For private/gated Hugging Face models:
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

LLM_MODEL_ID=unsloth/Qwen3.5-4B
FALLBACK_LLM_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
AUX_LLM_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
LLM_LOAD_MODE=auto
MAX_GPU_MEMORY=10.5GiB
MAX_INPUT_TOKENS=8192
MAX_NEW_TOKENS=900
START_MLFLOW_UI=1
OPEN_MLFLOW_UI_BROWSER=0

# Docker networking:
# Keep 0.0.0.0 inside the container.
# docker-compose.yml publishes the ports only to 127.0.0.1 on the host.
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_INBROWSER=0
MLFLOW_UI_HOST=0.0.0.0
MLFLOW_UI_PORT=5001
