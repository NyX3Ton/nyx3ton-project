FROM python:3.13-slim-bookworm
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/hf_cache \
    HF_HUB_CACHE=/app/hf_cache \
    TRANSFORMERS_CACHE=/app/hf_cache \
    TOKENIZERS_PARALLELISM=false \
    GRADIO_SERVER_NAME=0.0.0.0 \
    GRADIO_SERVER_PORT=7860 \
    GRADIO_INBROWSER=0 \
    START_MLFLOW_UI=1 \
    OPEN_MLFLOW_UI_BROWSER=0 \
    MLFLOW_UI_HOST=0.0.0.0 \
    MLFLOW_UI_PORT=5001 \
    MLFLOW_EXPERIMENT_NAME=local-prompt-simulator-docker-cpu \
    OPENVINO_DEVICE=CPU \
    FORCE_HF_FALLBACK=0 \
    LOCAL_FILES_ONLY=0 \
    MAX_INPUT_TOKENS=2048 \
    MAX_NEW_TOKENS=320 \
    TEMPERATURE=0.7 \
    TOP_P=0.9 \
    HF_CACHE_DIR=/app/hf_cache \
    OV_MODELS_DIR=/app/ov_models \
    OV_CACHE_DIR=/app/ov_cache \
    MLFLOW_ROOT_DIR=/app/mlflow_runs \
    RAG_UPLOAD_DIR=/app/rag_uploads \
    MARKDOWN_OUTPUT_DIR=/app/markdown_outputs \
    RAG_EMBED_DEVICE=cpu \
    RAG_MAX_CONTEXT_CHARS=12000 \
    APP_SCRIPT=ai-prompt-sim.py

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates build-essential pkg-config \
    libgomp1 libgl1 libglib2.0-0 poppler-utils \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel packaging

RUN python -m pip install --no-cache-dir \
    torch==2.12.0 \
    --index-url https://download.pytorch.org/whl/cpu

COPY requirements-docker-cpu.txt /app/requirements-docker-cpu.txt
RUN python -m pip install --no-cache-dir -r /app/requirements-docker-cpu.txt

COPY . /app

RUN mkdir -p \
    /app/hf_cache /app/ov_models /app/ov_cache /app/mlflow_runs \
    /app/rag_uploads /app/markdown_outputs /app/outputs

EXPOSE 7860 5001

CMD ["bash", "-lc", "python ${APP_SCRIPT}"]
