RAG_MAX_CONTEXT_CHARS=12000

GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_INBROWSER=0

START_MLFLOW_UI=1
OPEN_MLFLOW_UI_BROWSER=0
MLFLOW_UI_HOST=0.0.0.0
MLFLOW_UI_PORT=5001
MLFLOW_EXPERIMENT_NAME=local-prompt-simulator-docker-cpu

