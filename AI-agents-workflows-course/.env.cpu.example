APP_SCRIPT=ai-prompt-sim.py

LOCAL_MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507

OPENVINO_DEVICE=CPU
FORCE_HF_FALLBACK=0
LOCAL_FILES_ONLY=0

MAX_INPUT_TOKENS=2048
MAX_NEW_TOKENS=320
TEMPERATURE=0.7
TOP_P=0.9

RAG_EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
