# Reasoning backend selection: auto | cuda | openvino | rule
# auto tries CUDA (NVIDIA) first, then OpenVINO (Intel), then rule-based.
REASONER_BACKEND=auto

# --- CUDA backend (PyTorch + Transformers, NVIDIA GPU) ---
# Recommended dual-backend model (instruction-tuned, also exportable to
# OpenVINO). Leave empty to skip the CUDA LLM and use OpenVINO / rule-based.
# The model is downloaded to the local HF cache on first use; later runs load
# it from cache automatically (pre-fetch with: python app.py --download).
CUDA_MODEL_ID=unsloth/Qwen3-4B-Instruct-2507
CUDA_DEVICE=cuda:0
# Quantization: auto = 4-bit (bitsandbytes) when installed, else fp16.
# Force with "4bit" or disable with "fp16".
CUDA_QUANTIZATION=auto

# --- OpenVINO backend (Intel CPU/GPU/NPU) ---
# Point this at a model exported to OpenVINO IR. To use the same Qwen3-4B:
#   pip install "optimum[openvino]"
#   optimum-cli export openvino --model unsloth/Qwen3-4B-Instruct-2507 \
#       --weight-format int4 ./ov_qwen3_4b_instruct
# then set OPENVINO_MODEL_DIR to that folder. Leave empty to skip OpenVINO.
OPENVINO_MODEL_DIR=
OPENVINO_DEVICE=CPU

# --- Email (SMTP) ---
# Transport security is optional: starttls (default, port 587), ssl (implicit
# TLS, port 465), or none. SMTP_USER/SMTP_PASSWORD are also optional - login is
# only attempted when both are set. The recipient is entered in the UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PREDEFINED_RECIPIENT=

# --- Gradio server ---
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7861
