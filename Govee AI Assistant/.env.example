GOVEE_API_KEY=your-govee-api-key-here

# Optional: override the local LLM.
GOVEE_LLM_MODEL=unsloth/gemma-4-E4B-it

# Optional: fallback model, loaded only if the primary above fails to load
# (e.g. too large for the available VRAM). Empty = no fallback.
GOVEE_FALLBACK_MODEL_ID=unsloth/Qwen3.5-2B

# Optional: quantization for the local LLM: 4 (NF4, ~5GB VRAM), 8 (~9GB), or
# 0 for full bf16 (~16GB). Requires CUDA + bitsandbytes; ignored on CPU.
# The default 8B Gemma-4 needs 4-bit to fit a 12GB GPU.
QUANTIZE_BITS=0

# Optional: agent architecture. "single" (default) = the built-in tool-calling
# loop. "workflow" = LlamaIndex multi-agent orchestration (device + info agents
# with handoffs). Workflow is opt-in because multi-agent ReAct is less reliable
# on a small local model; switch back to single if it underperforms.
GOVEE_AGENT_MODE=single

# Optional: review and improve the final natural-language response after all
# tools have completed. It reuses the loaded model and adds up to two model
# generations per pass; it never re-runs device or information tools.
GOVEE_CRITIQUE_ENABLED=false
GOVEE_CRITIQUE_MAX_PASSES=1

# Optional: override the semantic-matching embedding model.
GOVEE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional: override the speech-to-text model.
GOVEE_STT_MODEL=openai/whisper-small

# Optional: choose speech-to-text device: auto, cpu, or cuda.
GOVEE_STT_DEVICE=cpu

# Optional: force Whisper language, e.g. english, slovak, sk, en.
# Leave empty for automatic language detection.
GOVEE_STT_LANGUAGE=

# Optional: recordings below this RMS are treated as silent.
GOVEE_STT_SILENCE_RMS=0.002

# Optional: default location for weather when the user doesn't specify one.
GOVEE_DEFAULT_LOCATION=

# Optional: comma-separated RSS feed URLs for general news (no topic given).
# Defaults to Google News top-stories RSS if unset.
GOVEE_NEWS_FEEDS=

# Optional: directory for the local Chroma vector-memory store.
GOVEE_MEMORY_DB=./chroma_memory

# Optional: relevance floor (0-1) for RAG memory recall. Empty = disabled
# (return top matches regardless of score). Tune per embedding model.
GOVEE_MEMORY_SIMILARITY_CUTOFF=

# Optional: address/port the Gradio server binds to (app.py).
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860

# Optional: HOST port exposed by Docker Compose (compose-only).
GRADIO_HOST_PORT=17861
